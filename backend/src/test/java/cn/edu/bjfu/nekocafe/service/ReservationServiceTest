package com.nekocafe.service;

import com.nekocafe.entity.Reservation;
import com.nekocafe.repository.ReservationRepository;
import com.nekocafe.exception.BizException;
import org.junit.jupiter.api.DisplayName;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.extension.ExtendWith;
import org.mockito.InjectMocks;
import org.mockito.Mock;
import org.mockito.junit.jupiter.MockitoExtension;

import java.util.Optional;

import static org.junit.jupiter.api.Assertions.*;
import static org.mockito.Mockito.*;

@ExtendWith(MockitoExtension.class) // 使用 Mockito 扩展，避免启动整个 Spring 容器，速度极快
public class ReservationServiceTest {

    @Mock
    private ReservationRepository reservationRepository; // Mock 掉数据库依赖

    @InjectMocks
    private ReservationService reservationService; // 注入到要测试的业务类中

    @Test
    @DisplayName("成功创建预约 - 理想流程")
    public void testCreateReservation_Success() {
        // 1. 准备测试数据和 Mock 行为
        Reservation mockReservation = new Reservation();
        mockReservation.setUserId(1L);
        mockReservation.setTableId(10L);

        // 模拟：当调用 repository 的 save 方法时，返回带有自增 ID 的对象
        when(reservationRepository.save(any(Reservation.class))).thenAnswer(invocation -> {
            Reservation saved = invocation.getArgument(0);
            saved.setId(100L); // 模拟生成主键
            return saved;
        });

        // 2. 执行被测方法
        Reservation result = reservationService.createReservation(1L, 10L);

        // 3. 断言验证结果
        assertNotNull(result.getId());
        assertEquals(100L, result.getId());
        // 验证数据库的 save 方法确实被调用过 1 次
        verify(reservationRepository, times(1)).save(any(Reservation.class));
    }

    @Test
    @DisplayName("创建预约失败 - 桌位已被占用（覆盖异常分支）")
    public void testCreateReservation_TableOccupied() {
        // 模拟：假设该桌位已被预约，Repository 查询返回已有数据
        when(reservationRepository.findByTableIdAndStatus(10L, "CONFIRMED"))
                .thenReturn(Optional.of(new Reservation()));

        // 执行并断言：期望抛出自定义的业务异常
        BizException exception = assertThrows(BizException.class, () -> {
            reservationService.createReservation(1L, 10L);
        });

        assertEquals("该桌位在当前时段已被占用", exception.getMessage());
        // 验证防刷逻辑生效，save 方法永远不会被调用
        verify(reservationRepository, never()).save(any(Reservation.class));
    }
}
