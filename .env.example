# ============================================
# NekoCafé 环境变量模板
# 复制为 .env 并填入真实值：cp .env.example .env
# ============================================

# --- 数据库连接 ---
DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=nekocafe
DB_USERNAME=admin_user
DB_PASSWORD=你的数据库密码

# --- Redis 连接 ---
REDIS_HOST=host.docker.internal
REDIS_PORT=6379
REDIS_PASSWORD=你的Redis密码

# --- JWT ---
JWT_SECRET=生产环境请替换为随机长字符串

# --- 微信小程序 ---
WX_APPID=你的微信小程序AppID
WX_SECRET=你的微信小程序AppSecret
