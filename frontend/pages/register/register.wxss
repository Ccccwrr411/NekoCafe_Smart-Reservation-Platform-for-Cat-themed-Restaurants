/* pages/register/register.wxss */
.register-container {
  min-height: 100vh;
  background: linear-gradient(160deg, #C97E5A 0%, #F7F0EB 60%);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 48rpx 60rpx;
  box-sizing: border-box;
}

/* ── Logo ── */
.register-logo {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 36rpx;
}
.logo-cat  { font-size: 80rpx; margin-bottom: 12rpx; }
.logo-name { font-size: 44rpx; font-weight: 800; color: #fff; letter-spacing: 4rpx; }
.logo-sub  { font-size: 24rpx; color: rgba(255,255,255,0.85); margin-top: 10rpx; }

/* ── 角色选择 ── */
.role-section {
  width: 100%;
  background: rgba(255,255,255,0.95);
  border-radius: 28rpx;
  padding: 32rpx 24rpx 24rpx;
  box-sizing: border-box;
  margin-bottom: 28rpx;
  box-shadow: 0 8rpx 32rpx rgba(201,126,90,0.18);
}
.role-title {
  font-size: 26rpx;
  color: #999;
  text-align: center;
  display: block;
  margin-bottom: 24rpx;
  letter-spacing: 1rpx;
}
.role-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}
.role-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 20rpx 6rpx 16rpx;
  background: #F7F0EB;
  border-radius: 18rpx;
  border: 2rpx solid transparent;
  transition: all 0.15s;
}
.role-card-active {
  background: #FFF5F0;
  border-color: #C97E5A;
  box-shadow: 0 0 0 4rpx rgba(201,126,90,0.15);
}
.role-icon  { font-size: 48rpx; margin-bottom: 8rpx; }
.role-name  { font-size: 25rpx; font-weight: 600; color: #333; }
.role-name-en { font-size: 19rpx; color: #999; margin-top: 4rpx; }
.role-card-active .role-name { color: #C97E5A; }

/* ── 表单卡片 ── */
.form-card {
  width: 100%;
  background: rgba(255,255,255,0.95);
  border-radius: 28rpx;
  padding: 36rpx 28rpx;
  box-sizing: border-box;
  margin-bottom: 36rpx;
  box-shadow: 0 8rpx 32rpx rgba(201,126,90,0.18);
}
.form-item {
  margin-bottom: 28rpx;
}
.form-item:last-child {
  margin-bottom: 0;
}
.form-label {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
  display: block;
}
.form-input {
  width: 100%;
  height: 88rpx;
  background: #F7F0EB;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  color: #333;
  box-sizing: border-box;
  border: 2rpx solid transparent;
  transition: border-color 0.2s;
}
/* 输入框错误态：红色边框 */
.form-input.input-error {
  border-color: #E53935;
  background: #FFF5F5;
}

/* ── 行内错误提示 ── */
.field-error {
  display: block;
  font-size: 24rpx;
  color: #E53935;
  margin-top: 8rpx;
  padding-left: 4rpx;
  line-height: 1.4;
}

/* ── 验证码行 ── */
.code-row {
  display: flex;
  align-items: flex-end;
}
.code-input-wrap {
  flex: 1;
  margin-right: 16rpx;
}
.btn-send-code {
  flex-shrink: 0;
  width: 200rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 24rpx;
  background: #C97E5A;
  color: #fff;
  border-radius: 16rpx;
  text-align: center;
  padding: 0;
  border: none;
}
.btn-send-code::after { border: none; }
.btn-code-disabled {
  background: #ccc !important;
  color: #999 !important;
}

/* ── 注册按钮 ── */
.btn-register {
  width: 100%;
  background: #C97E5A;
  color: #fff;
  border-radius: 50rpx;
  height: 96rpx;
  line-height: 96rpx;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(201,126,90,0.4);
}
.btn-register::after { border: none; }
.btn-disabled {
  background: #ccc !important;
  box-shadow: none !important;
}

/* ── 沙箱验证码提示 ── */
.sandbox-hint {
  margin-top: 8rpx;
  padding: 8rpx 16rpx;
  background: #FFF8E1;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #E65100;
}

/* ── 返回登录 ── */
.back-login {
  text-align: center;
  font-size: 28rpx;
  color: #C97E5A;
  margin-top: 24rpx;
}

/* ── 门店选择 ── */
.store-section {
  width: 100%;
  background: rgba(255,255,255,0.95);
  border-radius: 28rpx;
  padding: 28rpx 28rpx 24rpx;
  box-sizing: border-box;
  margin-bottom: 28rpx;
  box-shadow: 0 8rpx 32rpx rgba(201,126,90,0.18);
}
.store-title {
  font-size: 26rpx;
  color: #999;
  display: block;
  margin-bottom: 20rpx;
  letter-spacing: 1rpx;
}
.store-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  background: #F7F0EB;
  border-radius: 16rpx;
  padding: 0 24rpx;
  border: 2rpx solid transparent;
}
.store-picker-text {
  font-size: 30rpx;
  color: #333;
}
.store-picker-text.placeholder {
  color: #bbb;
}
.store-picker-arrow {
  font-size: 24rpx;
  color: #999;
}
