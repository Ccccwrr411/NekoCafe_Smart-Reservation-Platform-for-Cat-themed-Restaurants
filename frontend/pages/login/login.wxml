<!--pages/login/login.wxml-->
<view class="login-container">

  <!-- Logo -->
  <view class="login-logo">
    <text class="logo-cat">🐱</text>
    <text class="logo-name">NekoCafé</text>
    <text class="logo-sub">猫咪与咖啡的温馨相遇</text>
  </view>

  <!-- 登录方式 Tab -->
  <view class="login-tabs">
    <view class="tab-item {{loginTab === 'wx' ? 'tab-active' : ''}}" bindtap="switchTab" data-tab="wx">
      <text>微信登录</text>
    </view>
    <view class="tab-item {{loginTab === 'phone' ? 'tab-active' : ''}}" bindtap="switchTab" data-tab="phone">
      <text>手机号登录</text>
    </view>
  </view>

  <!-- 微信登录面板 -->
  <view class="login-panel" wx:if="{{loginTab === 'wx'}}">
    <!-- 角色选择 -->
    <view class="role-section">
      <text class="role-title">请选择您的身份</text>
      <view class="role-grid">
        <view
          wx:for="{{roles}}"
          wx:key="id"
          class="role-card {{selectedRole === item.id ? 'role-card-active' : ''}}"
          bindtap="onSelectRole"
          data-role="{{item.id}}"
        >
          <text class="role-icon">{{item.icon}}</text>
          <text class="role-name">{{item.name}}</text>
          <text class="role-name-en">{{item.nameEn}}</text>
        </view>
      </view>
    </view>

    <!-- 昵称设置（微信登录新用户） -->
    <view class="nickname-section">
      <text class="nickname-title">设置昵称</text>
      <input
        class="nickname-input"
        placeholder="给自己起个好听的名字"
        value="{{nickname}}"
        bindinput="onNicknameInput"
        maxlength="20"
      />
    </view>

    <!-- 门店选择（非顾客、非总部运营时显示） -->
    <view class="store-section" wx:if="{{selectedRole !== 'customer' && selectedRole !== 'hq_ops'}}">
      <text class="store-title">请选择所在门店</text>
      <picker
        mode="selector"
        range="{{storeNames}}"
        value="{{selectedStoreIndex}}"
        bindchange="onStorePick"
      >
        <view class="store-picker">
          <text class="store-picker-text">{{selectedStoreIndex >= 0 ? storeNames[selectedStoreIndex] : '请选择门店'}}</text>
          <text class="store-picker-arrow">▼</text>
        </view>
      </picker>
    </view>

    <!-- 微信登录按钮 -->
    <button
      class="btn-wx-login {{canWxLogin ? '' : 'btn-disabled'}}"
      bindtap="onMockLogin"
      loading="{{loading}}"
      disabled="{{!canWxLogin}}"
    >
      微信一键登录
    </button>
  </view>

  <!-- 手机号登录面板 -->
  <view class="login-panel" wx:if="{{loginTab === 'phone'}}">
    <view class="phone-form">
      <view class="form-item">
        <text class="form-label">手机号</text>
        <input
          class="form-input"
          type="number"
          maxlength="11"
          placeholder="请输入手机号"
          value="{{phone}}"
          bindinput="onPhoneInput"
        />
      </view>
      <view class="form-item">
        <text class="form-label">密码</text>
        <input
          class="form-input"
          password="true"
          placeholder="请输入密码"
          value="{{password}}"
          bindinput="onPasswordInput"
        />
      </view>
    </view>

    <button
      class="btn-wx-login {{phone && password ? '' : 'btn-disabled'}}"
      bindtap="onPhoneLogin"
      loading="{{loading}}"
      disabled="{{!phone || !password}}"
    >
      手机号登录
    </button>

    <view class="register-link" bindtap="goRegister">
      <text>还没有账号？立即注册</text>
    </view>
  </view>

  <text class="login-hint">登录即代表同意《用户协议》及《隐私政策》</text>

</view>
