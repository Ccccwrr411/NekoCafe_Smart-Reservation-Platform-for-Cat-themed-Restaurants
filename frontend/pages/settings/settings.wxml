<!--pages/settings/settings.wxml-->
<view class="container">
  <!-- 个人信息编辑区域 -->
  <view class="section-title">个人信息</view>
  <view class="settings-section card">
    <!-- 头像 -->
    <view class="setting-item" bindtap="onChangeAvatar">
      <text class="setting-label">头像</text>
      <view class="setting-right">
        <image class="avatar-preview" src="{{userInfo.avatarUrl || '/assets/default-avatar.png'}}" mode="aspectFill" />
        <text class="setting-arrow">›</text>
      </view>
    </view>

    <!-- 昵称 -->
    <view class="setting-item" bindtap="onEditNickname">
      <text class="setting-label">昵称</text>
      <view class="setting-right">
        <text class="setting-value">{{userInfo.nickName || '未设置'}}</text>
        <text class="setting-arrow">›</text>
      </view>
    </view>

    <!-- 手机号 -->
    <view class="setting-item" bindtap="onEditPhone">
      <text class="setting-label">手机号</text>
      <view class="setting-right">
        <text class="setting-value">{{userInfo.phone || '未绑定'}}</text>
        <text class="setting-arrow">›</text>
      </view>
    </view>

    <!-- 邮箱 -->
    <view class="setting-item" bindtap="onEditEmail">
      <text class="setting-label">邮箱</text>
      <view class="setting-right">
        <text class="setting-value">{{userInfo.email || '未绑定'}}</text>
        <text class="setting-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 安全设置 -->
  <view class="section-title">安全设置</view>
  <view class="settings-section card">
    <view class="setting-item" bindtap="onChangePassword">
      <text class="setting-label">修改密码</text>
      <text class="setting-arrow">›</text>
    </view>
  </view>

  <!-- 通用设置（保留原有功能） -->
  <view class="section-title">通用设置</view>
  <view class="settings-section card">
    <view
      wx:for="{{settings}}"
      wx:key="label"
      class="setting-item"
    >
      <text class="setting-label">{{item.label}}</text>
      <view wx:if="{{item.toggle !== undefined}}" class="setting-toggle-wrap">
        <switch 
          class="setting-toggle" 
          checked="{{item.value}}" 
          bindchange="toggleSetting"
          data-index="{{index}}"
        />
      </view>
      <view wx:elif="{{item.path}}" class="setting-right" bindtap="goPage" data-path="{{item.path}}">
        <text class="setting-arrow">›</text>
      </view>
      <text wx:else class="setting-value">{{item.value}}</text>
    </view>
  </view>

  <view class="settings-section card">
    <view class="setting-item" bindtap="clearCache">
      <text class="setting-label">清除缓存</text>
      <text class="setting-arrow">›</text>
    </view>
    <view class="setting-item" bindtap="goAbout">
      <text class="setting-label">关于我们</text>
      <text class="setting-arrow">›</text>
    </view>
  </view>

  <view class="logout-btn" bindtap="onLogout">退出登录</view>
</view>
