<!-- pages/hq/marketing.wxml -->
<view class="page">
  <!-- ===== Tab Bar ===== -->
  <view class="tab-bar">
    <view class="tab-item {{activeTab==='promotions'?'active':''}}" bindtap="switchTab" data-tab="promotions">活动管理</view>
    <view class="tab-item {{activeTab==='coupons'?'active':''}}" bindtap="switchTab" data-tab="coupons">发券管理</view>
  </view>

  <!-- ====== Tab 1: 活动管理 ====== -->
  <view wx:if="{{activeTab==='promotions'}}" class="tab-content">
    <!-- 筛选栏 -->
    <view class="filter-bar">
      <view class="filter-item {{filter==='all'?'active':''}}" bindtap="setFilter" data-filter="all">全部</view>
      <view class="filter-item {{filter==='active'?'active':''}}" bindtap="setFilter" data-filter="active">进行中</view>
      <view class="filter-item {{filter==='inactive'?'active':''}}" bindtap="setFilter" data-filter="inactive">已停用</view>
    </view>

    <!-- 新建按钮 -->
    <view class="add-btn" bindtap="showCreateModal">+ 新建活动</view>

    <!-- 活动卡片 -->
    <view wx:for="{{promotions}}" wx:key="promoId" class="promo-card">
      <view class="promo-header">
        <view class="promo-name">{{item.name}}</view>
        <view class="promo-type {{item.type==='DISCOUNT'?'discount':'voucher'}}">{{item.type==='DISCOUNT'?'折扣':'代金券'}}</view>
        <view class="promo-status {{item.isActive?'on':'off'}}">{{item.isActive?'启用':'停用'}}</view>
      </view>
      <view class="promo-meta">
        <text>📅 {{item.startTimeStr}} ~ {{item.endTimeStr}}</text>
      </view>
      <view class="promo-actions">
        <view class="btn" bindtap="showEditModal" data-item="{{item}}">编辑</view>
        <view class="btn {{item.isActive?'toggle-on':'toggle-off'}}" bindtap="togglePromo" data-id="{{item.promoId}}" data-active="{{item.isActive}}">{{item.isActive?'停用':'启用'}}</view>
        <view class="btn danger" bindtap="deletePromo" data-id="{{item.promoId}}" data-name="{{item.name}}">删除</view>
      </view>
    </view>

    <!-- 空状态 -->
    <view wx:if="{{promotions.length===0&&!loading}}" class="empty">暂无活动数据</view>
  </view>

  <!-- ====== Tab 2: 发券管理 ====== -->
  <view wx:if="{{activeTab==='coupons'}}" class="tab-content">
    <!-- 单人发券 -->
    <view class="send-section">
      <view class="section-title">🎫 单人发券</view>
      <view class="form-group">
        <view class="form-label">选择活动</view>
        <picker mode="selector" range="{{activePromoLabels}}" bindchange="onSinglePromoPick">
          <view class="form-picker">{{singlePromoLabel || '请选择活动'}}<text class="arrow">▼</text></view>
        </picker>
      </view>
      <view class="form-group">
        <view class="form-label">用户ID</view>
        <input class="form-input" type="number" placeholder="输入用户ID" value="{{singleUserId}}" bindinput="onSingleUserIdInput" />
      </view>
      <view class="form-group">
        <view class="form-label">过期时间（选填）</view>
        <picker mode="date" bindchange="onSingleExpirePick">
          <view class="form-picker">{{singleExpireStr || '不限制过期'}}<text class="arrow">▼</text></view>
        </picker>
      </view>
      <button class="send-btn" bindtap="sendSingleCoupon" disabled="{{!singlePromoId||!singleUserId}}">发送优惠券</button>
      <view wx:if="{{singleResult}}" class="result-box">{{singleResult}}</view>
    </view>

    <!-- 批量发券 -->
    <view class="send-section" style="margin-top:24rpx;">
      <view class="section-title">📮 批量发券</view>
      <view class="form-group">
        <view class="form-label">选择活动</view>
        <picker mode="selector" range="{{activePromoLabels}}" bindchange="onBatchPromoPick">
          <view class="form-picker">{{batchPromoLabel || '请选择活动'}}<text class="arrow">▼</text></view>
        </picker>
      </view>
      <view class="form-group">
        <view class="form-label">目标类型</view>
        <picker mode="selector" range="{{targetTypes}}" bindchange="onTargetTypePick">
          <view class="form-picker">{{batchTargetLabel || '请选择目标类型'}}<text class="arrow">▼</text></view>
        </picker>
      </view>
      <view class="form-group" wx:if="{{batchTargetType==='role'}}">
        <view class="form-label">角色</view>
        <picker mode="selector" range="{{roleLabels}}" bindchange="onRolePick">
          <view class="form-picker">{{batchRoleLabel || '请选择角色'}}<text class="arrow">▼</text></view>
        </picker>
      </view>
      <view class="form-group" wx:if="{{batchTargetType==='member_level'}}">
        <view class="form-label">会员等级</view>
        <picker mode="selector" range="{{memberLevels}}" bindchange="onMemberLevelPick">
          <view class="form-picker">{{batchMemberLevelLabel || '请选择等级'}}<text class="arrow">▼</text></view>
        </picker>
      </view>
      <view class="form-group">
        <view class="form-label">过期时间（选填）</view>
        <picker mode="date" bindchange="onBatchExpirePick">
          <view class="form-picker">{{batchExpireStr || '不限制过期'}}<text class="arrow">▼</text></view>
        </picker>
      </view>
      <button class="send-btn" bindtap="sendBatchCoupon" disabled="{{!batchPromoId||!batchTargetType}}">批量发送</button>
      <view wx:if="{{batchResult}}" class="result-box">{{batchResult}}</view>
    </view>
  </view>

  <!-- ====== Loading ====== -->
  <view wx:if="{{loading}}" class="loading-mask">
    <view class="loading-spinner">
      <wx:loading></wx:loading>
    </view>
  </view>
</view>
