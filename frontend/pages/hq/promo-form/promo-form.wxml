<!-- pages/hq/promo-form/promo-form.wxml -->
<view class="page">
  <!-- 顶部导航 -->
  <view class="nav-bar">
    <view class="nav-back" bindtap="goBack">← 返回</view>
    <view class="nav-title">{{mode==='edit'?'编辑活动':'新建活动'}}</view>
    <view class="nav-spacer"></view>
  </view>

  <!-- 表单区域 -->
  <scroll-view class="form-scroll" scroll-y="true" enhanced show-scrollbar="{{false}}">
    <view class="form-card">
      <!-- 活动名称 -->
      <view class="form-group">
        <view class="form-label">活动名称 *</view>
        <input class="form-input" placeholder="例如：新店开业8折" value="{{form.name}}" bindinput="onNameInput" />
      </view>

      <!-- 活动类型 -->
      <view class="form-group">
        <view class="form-label">活动类型 *</view>
        <picker mode="selector" range="{{typeLabels}}" bindchange="onTypePick">
          <view class="form-picker">{{formTypeLabel || '请选择'}}<text class="arrow">▼</text></view>
        </picker>
      </view>

      <!-- 折扣类型规则 -->
      <block wx:if="{{form.type==='DISCOUNT'}}">
        <view class="form-group">
          <view class="form-label">折扣（0~1，如0.8=8折）</view>
          <input class="form-input" type="digit" placeholder="0.8" value="{{form.ruleJson.discount}}" bindinput="onRuleInput" data-field="discount" />
        </view>
        <view class="form-group">
          <view class="form-label">最大优惠金额（元）</view>
          <input class="form-input" type="digit" placeholder="20" value="{{form.ruleJson.max_discount}}" bindinput="onRuleInput" data-field="max_discount" />
        </view>
        <view class="form-group">
          <view class="form-label">最低消费（元）</view>
          <input class="form-input" type="digit" placeholder="0" value="{{form.ruleJson.min_spend}}" bindinput="onRuleInput" data-field="min_spend" />
        </view>
        <view class="form-group">
          <view class="form-switch">
            <view class="form-label">是否可叠加</view>
            <switch checked="{{form.ruleJson.stackable}}" bindchange="onRuleSwitch" data-field="stackable" />
          </view>
        </view>
      </block>

      <!-- 代金券类型规则 -->
      <block wx:if="{{form.type==='VOUCHER'}}">
        <view class="form-group">
          <view class="form-label">减免金额（元）</view>
          <input class="form-input" type="digit" placeholder="20" value="{{form.ruleJson.reduction}}" bindinput="onRuleInput" data-field="reduction" />
        </view>
        <view class="form-group">
          <view class="form-label">最低消费（元）</view>
          <input class="form-input" type="digit" placeholder="100" value="{{form.ruleJson.min_spend}}" bindinput="onRuleInput" data-field="min_spend" />
        </view>
        <view class="form-group">
          <view class="form-switch">
            <view class="form-label">是否可叠加</view>
            <switch checked="{{form.ruleJson.stackable}}" bindchange="onRuleSwitch" data-field="stackable" />
          </view>
        </view>
      </block>

      <!-- 时间选择 -->
      <view class="form-group">
        <view class="form-label">开始时间 *</view>
        <picker mode="date" bindchange="onDatePick" data-field="startTime">
          <view class="form-picker">{{form.startTimeStr || '请选择'}}<text class="arrow">▼</text></view>
        </picker>
      </view>
      <view class="form-group">
        <view class="form-label">结束时间 *</view>
        <picker mode="date" bindchange="onDatePick" data-field="endTime">
          <view class="form-picker">{{form.endTimeStr || '请选择'}}<text class="arrow">▼</text></view>
        </picker>
      </view>

      <!-- 启用开关 -->
      <view class="form-group">
        <view class="form-switch">
          <view class="form-label">立即启用</view>
          <switch checked="{{form.isActive}}" bindchange="onActiveSwitch" />
        </view>
        <view class="form-hint">关闭则创建后为停用状态，需手动启用</view>
      </view>
    </view>

    <!-- 留出底部按钮空间 -->
    <view style="height: 140rpx;"></view>
  </scroll-view>

  <!-- 底部提交栏 -->
  <view class="bottom-bar">
    <view class="btn-cancel" bindtap="goBack">取消</view>
    <view class="btn-submit" bindtap="submitPromo">{{mode==='edit'?'保存':'创建'}}</view>
  </view>

  <!-- Loading -->
  <view wx:if="{{loading}}" class="loading-mask">
    <view class="loading-spinner">
      <wx:loading></wx:loading>
    </view>
  </view>
</view>
