<!--pages/hq/workspace.wxml—总部运营工作台-->
<view class="hq-page">

  <!-- ═════ 顶部 Banner ═════ -->
  <view class="hq-banner">
    <view class="banner-left">
      <text class="banner-title">📊 总部运营工作台</text>
      <text class="banner-sub">{{userName}} · 总部视角</text>
    </view>
    <view class="banner-right">
      <picker mode="selector" range="{{allStores}}" range-key="name" value="{{storePickerIndex}}" bindchange="onStoreChange">
        <text class="picker-text">切换门店 ▼</text>
      </picker>
    </view>
  </view>

  <!-- ═════ 主内容区 ═════ -->
  <view class="main-content">

    <!-- ────── Tab1：看板 ────── -->
    <block wx:if="{{activeTab==='dashboard'}}">
      <view class="dash-banner-inner">
        <text class="dash-banner-title">📊 数据看板</text>
        <text class="dash-banner-sub">总部视角 · {{allStores[storePickerIndex].name}}</text>
      </view>

      <view wx:if="{{loading}}" class="loading-wrap"><text>加载中...</text></view>

      <block wx:if="{{!loading && metrics}}">
        <!-- 今日概览：4 个核心数字 -->
        <view class="overview-card">
          <text class="card-title">📊 今日概览</text>
          <view class="overview-grid">
            <view class="ov-item">
              <text class="ov-val ov-revenue">¥{{metrics.todayOverview.revenue}}</text>
              <text class="ov-label">今日营收</text>
            </view>
            <view class="ov-item">
              <text class="ov-val ov-orders">{{metrics.todayOverview.orderCount}}</text>
              <text class="ov-label">订单数</text>
            </view>
            <view class="ov-item">
              <text class="ov-val ov-members">{{metrics.todayOverview.newMembers}}</text>
              <text class="ov-label">新会员</text>
            </view>
            <view class="ov-item">
              <text class="ov-val ov-avg">¥{{metrics.todayOverview.avgOrderValue}}</text>
              <text class="ov-label">客单价</text>
            </view>
          </view>
        </view>

        <!-- 近 7 天坪效 折线图 -->
        <view class="info-card">
          <text class="card-title">📈 近{{metrics.spaceEfficiency.labels.length}}天坪效（元/m²/天）</text>
          <view class="chart-wrap">
            <canvas type="2d" id="chart-space" class="chart-canvas"></canvas>
          </view>
        </view>

        <!-- 翻台率 柱状图 -->
        <view class="info-card">
          <text class="card-title">🔄 近{{metrics.turnoverRate.labels.length}}天翻台率</text>
          <view class="chart-wrap">
            <canvas type="2d" id="chart-turnover" class="chart-canvas"></canvas>
          </view>
        </view>

        <!-- 会员复购率 饼图 -->
        <view class="info-card">
          <text class="card-title">👥 会员复购率（近{{metrics.repurchaseRate.labels.length}}天）</text>
          <view class="chart-wrap chart-wrap-pie">
            <canvas type="2d" id="chart-repurchase" class="chart-canvas"></canvas>
          </view>
        </view>
      </block>

      <view wx:if="{{!loading && !metrics}}" class="empty">暂无数据</view>
    </block>

    <!-- ────── Tab2：运营 ────── -->
    <block wx:if="{{activeTab==='marketing'}}">
      <!-- 运营子 Tab -->
      <view class="sub-tab-bar">
        <view class="sub-tab-item {{promoSubTab==='promotions'?'active':''}}" bindtap="switchPromoSubTab" data-tab="promotions">活动管理</view>
        <view class="sub-tab-item {{promoSubTab==='coupons'?'active':''}}" bindtap="switchPromoSubTab" data-tab="coupons">发券管理</view>
      </view>

      <!-- ===== 子Tab1：活动管理 ===== -->
      <view wx:if="{{promoSubTab==='promotions'}}" class="promo-sub-content">
        <!-- 筛选栏 -->
        <view class="filter-bar">
          <view class="filter-item {{promoFilter==='all'?'active':''}}" bindtap="setPromoFilter" data-filter="all">全部</view>
          <view class="filter-item {{promoFilter==='active'?'active':''}}" bindtap="setPromoFilter" data-filter="active">进行中</view>
          <view class="filter-item {{promoFilter==='inactive'?'active':''}}" bindtap="setPromoFilter" data-filter="inactive">已停用</view>
        </view>

        <view class="add-btn" bindtap="showCreatePromoModal">+ 新建活动</view>

        <!-- 活动卡片 -->
        <view wx:for="{{promotions}}" wx:key="promoId" class="promo-card">
          <view class="pc-header">
            <text class="pc-name">{{item.name}}</text>
            <text class="pc-type {{item.type==='DISCOUNT'?'discount':'voucher'}}">{{item.type==='DISCOUNT'?'折扣':'代金券'}}</text>
            <text class="pc-status {{item.isActive?'on':'off'}}">{{item.isActive?'启用':'停用'}}</text>
          </view>
          <view class="pc-meta">📅 {{item.startTimeStr}} ~ {{item.endTimeStr}}</view>
          <view class="pc-actions">
            <view class="btn-sm" bindtap="editPromo" data-item="{{item}}">编辑</view>
            <view class="btn-sm" bindtap="togglePromo" data-id="{{item.promoId}}" data-active="{{item.isActive}}">{{item.isActive?'停用':'启用'}}</view>
            <view class="btn-sm danger" bindtap="deletePromo" data-id="{{item.promoId}}" data-name="{{item.name}}">删除</view>
          </view>
        </view>
        <view wx:if="{{promotions.length===0 && !loading}}" class="empty">暂无活动</view>
      </view>

      <!-- ===== 子Tab2：发券管理 ===== -->
      <view wx:if="{{promoSubTab==='coupons'}}" class="promo-sub-content">
        <view class="coupon-section">
          <view class="cs-title">🎫 单人发券</view>
          <view class="form-group" style="margin-bottom:16rpx;">
            <view class="form-label">选择活动</view>
            <picker mode="selector" range="{{activePromoLabels}}" bindchange="onSinglePromoPick">
              <view class="form-picker">{{singlePromoLabel || '请选择活动'}} <text class="arrow">▼</text></view>
            </picker>
          </view>
          <view class="form-group" style="margin-bottom:16rpx;">
            <view class="form-label">用户ID</view>
            <input class="form-input" type="number" placeholder="输入用户ID" value="{{singleUserId}}" bindinput="onSingleUserId" />
          </view>
          <button class="send-btn" bindtap="sendSingleCoupon" disabled="{{singlePromoIdx<0 || !singleUserId}}">发送优惠券</button>
          <view wx:if="{{singleResult}}" class="result-text">{{singleResult}}</view>
        </view>
        <view class="coupon-section" style="margin-top:24rpx;">
          <view class="cs-title">📮 批量发券</view>
          <view class="form-group" style="margin-bottom:16rpx;">
            <view class="form-label">选择活动</view>
            <picker mode="selector" range="{{activePromoLabels}}" bindchange="onBatchPromoPick">
              <view class="form-picker">{{batchPromoLabel || '请选择活动'}} <text class="arrow">▼</text></view>
            </picker>
          </view>
          <view class="form-group" style="margin-bottom:16rpx;">
            <view class="form-label">目标类型</view>
            <picker mode="selector" range="{{batchTargetTypes}}" bindchange="onBatchTargetPick">
              <view class="form-picker">{{batchTargetLabel || '请选择目标类型'}} <text class="arrow">▼</text></view>
            </picker>
          </view>
          <view class="form-group" style="margin-bottom:16rpx;" wx:if="{{batchTargetType==='role'}}">
            <view class="form-label">角色</view>
            <picker mode="selector" range="{{['顾客','店员','店长','总部运营','猫咪管家']}}" bindchange="onBatchRolePick">
              <view class="form-picker">{{batchRoleLabel || '请选择角色'}} <text class="arrow">▼</text></view>
            </picker>
          </view>
          <view class="form-group" style="margin-bottom:16rpx;" wx:if="{{batchTargetType==='member_level'}}">
            <view class="form-label">会员等级</view>
            <picker mode="selector" range="{{['普通会员','银卡会员','金卡会员','钻石会员']}}" bindchange="onBatchMemberPick">
              <view class="form-picker">{{batchMemberLabel || '请选择等级'}} <text class="arrow">▼</text></view>
            </picker>
          </view>
          <button class="send-btn" bindtap="sendBatchCoupon" disabled="{{batchPromoIdx<0 || !batchTargetType}}">批量发送</button>
          <view wx:if="{{batchResult}}" class="result-text">{{batchResult}}</view>
        </view>
      </view>
    </block>

    <!-- ────── Tab3：我的 ────── -->
    <block wx:if="{{activeTab==='profile'}}">
      <view class="profile-section" wx:if="{{userInfo}}">
        <view class="avatar-wrap">
          <image class="avatar" src="{{userInfo.avatarUrl || '/assets/icons/profile.png'}}" mode="aspectFill" />
        </view>
        <view class="info-row"><text class="info-label">昵称</text><text>{{userInfo.nickName || '未设置'}}</text></view>
        <view class="info-row"><text class="info-label">手机</text><text>{{userInfo.phone || '未绑定'}}</text></view>
        <view class="info-row"><text class="info-label">角色</text><text>总部运营</text></view>
      </view>
      <button class="logout-btn" bindtap="onLogout">退出登录</button>
    </block>
  </view>

  <!-- ═════ 底部导航栏 ═════ -->
  <view class="bottom-nav">
    <view class="nav-item {{activeTab==='dashboard'?'nav-active':''}}" bindtap="switchTab" data-tab="dashboard">
      <text class="nav-icon">📊</text>
      <text class="nav-label">看板</text>
    </view>
    <view class="nav-item {{activeTab==='marketing'?'nav-active':''}}" bindtap="switchTab" data-tab="marketing">
      <text class="nav-icon">📋</text>
      <text class="nav-label">运营</text>
    </view>
    <view class="nav-item {{activeTab==='profile'?'nav-active':''}}" bindtap="switchTab" data-tab="profile">
      <text class="nav-icon">👤</text>
      <text class="nav-label">我的</text>
    </view>
  </view>

</view>
