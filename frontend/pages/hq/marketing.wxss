/* pages/hq/marketing.wxss */
page {
  background: #F7F0EB;
  font-size: 28rpx;
}

/* ── Tab Bar ── */
.tab-bar {
  display: flex;
  background: #fff;
  border-bottom: 1rpx solid #eee;
}
.tab-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 30rpx;
  color: #666;
  position: relative;
}
.tab-item.active {
  color: #C97E5A;
  font-weight: 600;
}
.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 4rpx;
  background: #C97E5A;
  border-radius: 2rpx;
}

/* ── Filter Bar ── */
.filter-bar {
  display: flex;
  padding: 20rpx 24rpx;
  gap: 16rpx;
  background: #fff;
  margin-top: 16rpx;
}
.filter-item {
  padding: 10rpx 28rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #666;
  background: #F5F5F5;
}
.filter-item.active {
  color: #fff;
  background: #C97E5A;
}

/* ── Add Button ── */
.add-btn {
  margin: 20rpx 24rpx;
  padding: 20rpx;
  text-align: center;
  background: #C97E5A;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 12rpx;
}

/* ── Promotion Card ── */
.tab-content {
  padding-bottom: 40rpx;
}
.promo-card {
  margin: 16rpx 24rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.promo-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}
.promo-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  flex: 1;
}
.promo-type {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
  margin-left: 16rpx;
}
.promo-type.discount {
  background: #FFF3E0;
  color: #E65100;
}
.promo-type.voucher {
  background: #E8F5E9;
  color: #2E7D32;
}
.promo-status {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
  margin-left: 12rpx;
}
.promo-status.on {
  background: #E3F2FD;
  color: #1565C0;
}
.promo-status.off {
  background: #F5F5F5;
  color: #999;
}
.promo-meta {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 16rpx;
}
.promo-meta text {
  margin-right: 24rpx;
}
.promo-actions {
  display: flex;
  gap: 16rpx;
  justify-content: flex-end;
  border-top: 1rpx solid #f0f0f0;
  padding-top: 16rpx;
}
.promo-actions .btn {
  padding: 8rpx 24rpx;
  font-size: 24rpx;
  border-radius: 8rpx;
  border: 1rpx solid #ddd;
  color: #666;
  background: #fff;
}
.promo-actions .btn.toggle-on {
  color: #FF9800;
  border-color: #FF9800;
}
.promo-actions .btn.toggle-off {
  color: #4CAF50;
  border-color: #4CAF50;
}
.promo-actions .btn.danger {
  color: #F44336;
  border-color: #F44336;
}

/* ── Empty State ── */
.empty {
  text-align: center;
  padding: 80rpx 0;
  color: #bbb;
  font-size: 28rpx;
}

/* ── Modal ── */
.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}
.modal-box {
  width: 85vw;
  max-width: 700rpx;
  max-height: 85vh;
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}
.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.modal-title {
  font-size: 32rpx;
  font-weight: 600;
}
.modal-close {
  font-size: 36rpx;
  color: #999;
  padding: 8rpx;
}
.modal-body {
  padding: 24rpx 32rpx;
  flex: 1;
  overflow-y: auto;
}
.modal-footer {
  display: flex;
  padding: 20rpx 32rpx;
  gap: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}
.modal-footer .btn {
  flex: 1;
  padding: 18rpx;
  text-align: center;
  border-radius: 12rpx;
  font-size: 28rpx;
}
.modal-footer .btn-cancel {
  background: #f5f5f5;
  color: #666;
}
.modal-footer .btn-confirm {
  background: #C97E5A;
  color: #fff;
}

/* ── Form Fields ── */
.form-group {
  margin-bottom: 24rpx;
}
.form-label {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 8rpx;
  display: block;
}
.form-input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  background: #f8f8f8;
  border-radius: 12rpx;
  font-size: 30rpx;
  box-sizing: border-box;
  border: 1rpx solid #eee;
}
.form-input:focus {
  border-color: #C97E5A;
  background: #fff;
}
.form-textarea {
  width: 100%;
  min-height: 120rpx;
  padding: 16rpx 20rpx;
  border: 1rpx solid #ddd;
  border-radius: 10rpx;
  font-size: 26rpx;
  box-sizing: border-box;
}
.form-picker {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  background: #f8f8f8;
  border-radius: 12rpx;
  font-size: 30rpx;
  color: #333;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-sizing: border-box;
  border: 1rpx solid #eee;
}
.form-picker .arrow {
  color: #bbb;
  font-size: 24rpx;
}
.form-switch {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
}
.form-hint {
  font-size: 22rpx;
  color: #aaa;
  margin-top: 4rpx;
}

/* ── Coupon Send Section ── */
.send-section {
  margin: 16rpx 24rpx 0;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
}
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.send-btn {
  margin-top: 20rpx;
  padding: 18rpx;
  text-align: center;
  background: #C97E5A;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 12rpx;
}
.send-btn[disabled] {
  background: #ccc;
}
.result-box {
  margin-top: 16rpx;
  padding: 16rpx;
  background: #F5F5F5;
  border-radius: 10rpx;
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}
.result-box .success {
  color: #4CAF50;
}
.result-box .fail {
  color: #F44336;
}

/* ── Loading overlay ── */
.loading-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.3);
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: center;
}
.loading-spinner {
  width: 120rpx;
  height: 120rpx;
  background: #fff;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
