/* pages/hq/promo-form/promo-form.wxss */
page {
  background: #F7F0EB;
  font-size: 28rpx;
}

/* ── Navigation Bar ── */
.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
  height: 88rpx;
  background: #C97E5A;
  color: #fff;
  position: sticky;
  top: 0;
  z-index: 100;
}
.nav-back {
  font-size: 28rpx;
  padding: 8rpx 16rpx;
}
.nav-title {
  font-size: 32rpx;
  font-weight: 600;
}
.nav-spacer {
  width: 100rpx;
}

/* ── Form Card ── */
.form-scroll {
  height: calc(100vh - 88rpx - 120rpx);
}
.form-card {
  margin: 20rpx 24rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx 28rpx;
}

/* ── Form Fields ── */
.form-group {
  margin-bottom: 28rpx;
}
.form-label {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 8rpx;
  display: block;
}
.form-input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  background: #f8f8f8;
  border-radius: 12rpx;
  font-size: 30rpx;
  box-sizing: border-box;
  border: 1rpx solid #eee;
}
.form-input:focus {
  border-color: #C97E5A;
  background: #fff;
}
.form-picker {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  background: #f8f8f8;
  border-radius: 12rpx;
  font-size: 30rpx;
  color: #333;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-sizing: border-box;
  border: 1rpx solid #eee;
}
.form-picker .arrow {
  color: #bbb;
  font-size: 24rpx;
}
.form-switch {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
}
.form-hint {
  font-size: 22rpx;
  color: #aaa;
  margin-top: 4rpx;
}

/* ── Bottom Bar ── */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  gap: 20rpx;
  background: #fff;
  border-top: 1rpx solid #f0f0f0;
  z-index: 100;
}
.btn-cancel {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: #f5f5f5;
  color: #666;
  font-size: 30rpx;
  border-radius: 12rpx;
}
.btn-submit {
  flex: 2;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: #C97E5A;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 12rpx;
}

/* ── Loading ── */
.loading-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.3);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}
.loading-spinner {
  width: 120rpx;
  height: 120rpx;
  background: #fff;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
