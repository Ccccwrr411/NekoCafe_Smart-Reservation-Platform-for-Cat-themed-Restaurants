/* pages/contact/contact.wxss */
.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 40rpx;
}

.contact-header {
  background: linear-gradient(135deg, #C97E5A, #8B5A3C);
  padding: 28rpx 32rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.header-icon {
  font-size: 48rpx;
  margin-bottom: 6rpx;
}

.header-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 4rpx;
}

.header-desc {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.75);
}

.card {
  margin: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.contact-card {
  padding: 8rpx 0;
}

.contact-item {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.contact-item:last-child {
  border-bottom: none;
}

.contact-icon {
  font-size: 40rpx;
  width: 56rpx;
  text-align: center;
}

.contact-content {
  flex: 1;
  margin-left: 16rpx;
}

.contact-label {
  font-size: 26rpx;
  color: #999;
  display: block;
  margin-bottom: 4rpx;
}

.contact-value {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.contact-arrow {
  font-size: 32rpx;
  color: #ccc;
}

/* 分区标题 */
.section-title {
  font-size: 26rpx;
  color: #999;
  margin: 32rpx 24rpx 12rpx;
  font-weight: 500;
}

/* 店铺信息卡片 */
.info-card {
  padding: 0;
}

.info-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.info-item:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 26rpx;
  color: #999;
  width: 140rpx;
  flex-shrink: 0;
}

.info-value {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
  flex: 1;
}

/* FAQ 卡片 */
.faq-card {
  padding: 0;
}

.faq-item {
  padding: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.faq-item:last-child {
  border-bottom: none;
}

.faq-q {
  display: flex;
  align-items: flex-start;
  margin-bottom: 12rpx;
}

.faq-q-icon {
  width: 36rpx;
  height: 36rpx;
  background: var(--color-primary, #C97E5A);
  color: #fff;
  font-size: 22rpx;
  font-weight: 700;
  border-radius: 8rpx;
  text-align: center;
  line-height: 36rpx;
  flex-shrink: 0;
  margin-right: 12rpx;
}

.faq-q-text {
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
  line-height: 36rpx;
}

.faq-a {
  display: flex;
  align-items: flex-start;
  padding-left: 48rpx;
}

.faq-a-icon {
  width: 36rpx;
  height: 36rpx;
  background: #4CAF50;
  color: #fff;
  font-size: 22rpx;
  font-weight: 700;
  border-radius: 8rpx;
  text-align: center;
  line-height: 36rpx;
  flex-shrink: 0;
  margin-right: 12rpx;
}

.faq-a-text {
  font-size: 24rpx;
  color: #666;
  line-height: 1.7;
  flex: 1;
}

.tips-card {
  padding: 24rpx;
}

.tips-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
  display: block;
}

.tips-content {
  font-size: 24rpx;
  color: #666;
  line-height: 1.8;
  display: block;
}